<?xml version='1.0' encoding='utf-8'?>
<interface version="1.1">
  <object class="tk.Frame" id="frame">
    <property name="height">500</property>
    <property name="width">800</property>
    <layout manager="pack">
      <property name="propagate">True</property>
      <property name="side">top</property>
    </layout>
    <child>
      <object class="tk.Label" id="intro">
        <property name="font">{Ubuntu} 12 {bold italic underline}</property>
        <property name="text" translatable="yes">Welcome to PDP Sales Analysis </property>
        <layout manager="pack">
          <property name="anchor">center</property>
          <property name="padx">10</property>
          <property name="pady">25</property>
          <property name="propagate">True</property>
          <property name="side">top</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Label" id="dbselect">
        <property name="font">{Ubuntu} 10 {}</property>
        <property name="text" translatable="yes">Select Database File: </property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="rely">0.69</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Text" id="text1">
        <property name="height">1</property>
        <property name="padx">10</property>
        <property name="text" translatable="yes">FileName</property>
        <property name="width">20</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="relx">0.53</property>
          <property name="rely">0.69</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Button" id="submit">
        <property name="text" translatable="yes">Enter</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="bordermode">inside</property>
          <property name="relx">0.78</property>
          <property name="rely">1.0</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Button" id="browser">
        <property name="text" translatable="yes">Browse</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="relx">0.40</property>
          <property name="rely">1.0</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
