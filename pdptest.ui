<?xml version='1.0' encoding='utf-8'?>
<interface version="1.1">
  <object class="tk.Frame" id="introframe">
    <property name="height">450</property>
    <property name="width">800</property>
    <layout manager="pack">
      <property name="propagate">True</property>
      <property name="side">top</property>
    </layout>
    <child>
      <object class="tk.Label" id="heading">
        <property name="font">{ubuntu} 20 {bold underline}</property>
        <property name="text" translatable="yes">Welcome to PDP Sales Analysis!</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.5</property>
          <property name="rely">0.1</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Label" id="dbsel">
        <property name="font">{ubuntu} 12 {}</property>
        <property name="text" translatable="yes">Enter Database File Path: </property>
        <layout manager="place">
          <property name="anchor">w</property>
          <property name="relx">0.1</property>
          <property name="rely">0.5</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Entry" id="fileloctext">
        <property name="text" translatable="yes">DataBaseFilePath</property>
        <layout manager="place">
          <property name="anchor">w</property>
          <property name="relx">0.415</property>
          <property name="rely">0.5</property>
          <property name="width">450</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Button" id="browsebtn">
        <property cbtype="simple" name="command" type="command">select</property>
        <property name="text" translatable="yes">Browse</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="height">50</property>
          <property name="relx">0.5</property>
          <property name="rely">0.6</property>
          <property name="width">150</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Button" id="filelocsubmit">
        <property name="text" translatable="yes">Enter</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="height">50</property>
          <property name="relx">0.73</property>
          <property name="rely">0.6</property>
          <property name="width">150</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
